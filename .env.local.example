# Copy to .env.local and fill in. .env.local is gitignored.
#
#   cp .env.local.example .env.local
#
# Phase 1 (calculator + replay eval) needs NONE of this — it runs on Node alone.
# Add each section as you reach the phase that needs it.


# ── Database ─────────────────────────────────────────────── Phase 3+ ──
# Postgres + pgvector from docker-compose.yml.
# Host port is 5433 on purpose — avoids clashing with the pharmacy-pos DB on 5432.
# The password here matches docker-compose.yml; it is a local dev container only.
DATABASE_URL=postgres://postgres:secret@localhost:5433/ragdb


# ── Embeddings — LOCAL ONLY ──────────────────────────────── Phase 3+ ──
# Ollama runs on your machine so personal figures never reach a hosted provider.
# Ollama exposes an OpenAI-compatible endpoint, so the same SDK serves both providers.
OLLAMA_BASE_URL=http://localhost:11434/v1

# WARNING: this is a hard contract with the database.
# nomic-embed-text = 768 dimensions, and db/schema.sql declares vector(768).
# Changing the model requires a schema migration AND a full re-index.
EMBED_MODEL=nomic-embed-text


# ── Generation — hosted ──────────────────────────────────── Phase 4+ ──
# FreeLLMAPI gateway (runs separately: https://freellmapi.co/install.sh).
# Only public rule text and anonymised derived values are ever sent here.
# NEVER point EMBED_MODEL at this — embeddings stay local.
FREELLMAPI_BASE_URL=http://localhost:3001/v1

# Unified key from the FreeLLMAPI dashboard Keys page header.
FREELLMAPI_KEY=

# "auto" lets the router pick and fail over across providers.
# Fine for generation; embeddings are always pinned (see above).
CHAT_MODEL=auto


# ── Retrieval ────────────────────────────────────────────── Phase 4+ ──
# Cosine search ALWAYS returns rows, even when nothing relevant exists.
# Below this similarity, the model is not called at all and the app says
# it doesn't know. Raise it if out-of-scope questions get answered;
# lower it if in-scope questions get refused.
RETRIEVAL_SCORE_FLOOR=0.5
